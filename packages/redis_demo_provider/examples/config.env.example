# redis_demo_provider 配置样例（复制为实际 env 使用；勿提交真实凭证）
# 选型说明见 ../README.md

# ---------- 形态一：fakeredis（离线，推荐默认） ----------
REDIS_PROVIDER=acme_demo

# ---------- 形态二：Wrapper（治理演示；切换时注释掉上面一行） ----------
# REDIS_PROVIDER=redis_demo_provider.wrapper:WrapperDemoProvider
# REDIS_PROVIDER_CONFIG={"appId":"demo-app","passport":"demo-pass","maxAttempts":3,"fakeredis":true}
# 治理注入（默认全关=透明模式）：
# REDIS_PROVIDER_CONFIG={"appId":"demo-app","passport":"demo-pass","delayMs":5,"failureRate":0.0,"rateLimitPerSec":0,"fakeredis":true}

# ---------- 底座连接（形态一连真实实例不需要；native/形态二真实底座时用） ----------
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=change-me
# REDIS_MODE=single
# REDIS_TRANSACTION_ENABLED=true

# ---------- 契约套件目标（验收第 3 条自证动作） ----------
# REDIS_CONTRACT_TARGET=acme_demo
