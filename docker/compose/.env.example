# Docker Compose 部署配置

# ============ 镜像配置（必填） ============
# 通过 docker images 命令查询，格式为 REPOSITORY:TAG (将 TAG 替换为实际镜像版本)
STUDIO_CONSOLE_IMAGE=studio-console:<TAG>
STUDIO_MANAGER_IMAGE=studio-manager:<TAG>
STUDIO_RUNTIME_IMAGE=studio-runtime:<TAG>
STUDIO_BUILDER_IMAGE=studio-builder:<TAG>

# ============ 数据库配置（必填） ============
# 数据库名需与实际创建的数据库名一致
# SPRING_DATASOURCE_URL格式：
# MySQL：jdbc:mariadb://<MYSQL_IP>:3306/<DB_NAME>?allowMultiQueries=true
# GaussDB：jdbc:opengauss://<HOST1>:8000,<HOST2>:8000,<HOST3>:8000/<DB_NAME>?targetServerType=master
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# 驱动配置。数据库为GaussDB时，去掉下面这行行首的#号即可
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.huawei.opengauss.jdbc.Driver

# Builder 提示词优化任务持久化（不填则仅存内存，重启后丢失）
# 数据库类型：mysql 或 gaussdb，默认mysql
STORE_DB_TYPE=mysql
# MySQL默认端口3306，GaussDB默认端口5432
# GaussDB多节点时HOST填多个IP逗号分隔，自动寻主
STORE_DB_HOST=
STORE_DB_PORT=3306
STORE_DB_USER=
STORE_DB_PASSWORD=
STORE_DB_DATABASE=agent-builder
# Schema 模式（仅GaussDB生效）：设置后连接以该 schema 作为默认 search_path；为空则用数据库默认
STORE_DB_SCHEMA=
# SSL模式（仅GaussDB生效）：disable（默认）/ require / verify-ca / verify-full
STORE_DB_SSLMODE=disable

# ============ Redis配置（必填） ============
# 单机模式：填写 REDIS_HOST、REDIS_PORT、REDIS_PASSWORD，其余清空
# 集群模式：填写 REDIS_CLUSTER_NODES、REDIS_PASSWORD、REDIS_MODE，其余清空
# 哨兵模式：填写 REDIS_HOST、REDIS_SENTINEL_MASTER、REDIS_SENTINEL_PORTS、REDIS_SENTINEL_NODES、REDIS_PASSWORD、REDIS_MODE，其余清空
# Redis服务地址，单机模式为Redis节点IP，哨兵模式为哨兵节点IP
REDIS_HOST=
# Redis单机端口，默认6379
REDIS_PORT=6379
# Redis密码，单机/集群/哨兵模式均需填写
REDIS_PASSWORD=

# runtime服务Redis模式，单机填single，集群填cluster，哨兵填sentinel
REDIS_MODE=single
# runtime服务Redis数据库编号，默认0
REDIS_DATABASE=0
# Redis集群节点地址，格式：host1:port1,host2:port2,host3:port3
REDIS_CLUSTER_NODES=

# Redis哨兵master名称
REDIS_SENTINEL_MASTER=
# Redis哨兵端口，格式：port1,port2（Java服务连接哨兵用，与REDIS_HOST配合）
REDIS_SENTINEL_PORTS=
# Redis哨兵节点地址，格式：host1:port1,host2:port2,host3:port3（runtime服务使用）
REDIS_SENTINEL_NODES=
# Redis pipeline 事务开关，true 使用标准事务，false 不使用事务
REDIS_TRANSACTION_ENABLED=true

# ============ 存储类型配置 ==================
# 三种类型 OBS/LOCAL/CUSTOM 默认使用obs对象存储，local为本地文件存储，custom为自定义实现存储接口
STORAGE_TYPE=OBS
# 非必填，storage_type=CUSTOM必填，custom类型实现的FileStore接口类，例如 com.xxx.CustomFileStore
STORAGE_CUSTOM_CLASS=
# 自定义jar包位置
STORAGE_CUSTOM_CLASSPATH=
# 非必填，storage_type=LOCAL必填，local相关配置
# 本地文件存储根目录
STORAGE_LOCAL_BASE_PATH=
STORAGE_LOCAL_BUCKET=
STORAGE_LOCAL_STAGING_BUCKET=
# 本地manager服务启动地址，提供导出接口用于导出文件
STORAGE_LOCAL_SERVER_URL=
# runtime侧自定义类型存储配置 非必填，storage_type=CUSTOM必填，custom类型实现的ObjectStorageProvider接口类，例如 CustomLocalStorageProvider
RUNTIME_STORAGE_CUSTOM_CLASS=
# 自定义脚本位置
RUNTIME_STORAGE_CUSTOM_MODULE=

# ============ 对象存储配置（必填） ============
# OBS_BUCKET 需提前在对象存储中创建
# OBS_URL格式：
# MinIO：https://<MINIO_IP>:9000
# 公有云OBS：https://<OBS_ENDPOINT>:443
OBS_URL=
OBS_BUCKET=
OBS_AK=
OBS_SK=
# runtime服务对象存储SSL验证
DATASOURCE_OBS_ENABLE_SSL=false
# runtime服务对象存储寻址方式：path（路径风格，默认）或 virtual（虚拟托管风格）
DATASOURCE_OBS_PATH_STYLE=path

# ============ 服务间调用地址（默认无需修改） ============
# 以下地址HTTPS启动需要改成https
# 模型配置来源策略：env（环境变量）/ ir（旧版路由）/ obs（OBS直连，默认，绕过模型路由）
MODEL_CONFIG_STRATEGY=obs
# 模型缓存 LRU 容量，默认 500
MAX_MODEL_SERVICE_CACHE_NUM=500
MAX_MODEL_AUTH_CACHE_NUM=500
# 模型缓存 TTL（秒），L1 内存默认 60s，L2 Redis 默认 300s
MODEL_CACHE_MEM_TTL=60
MODEL_CACHE_REDIS_TTL=300
AGENT_RUNTIME_ENDPOINT=http://studio-runtime:31014
# manager 鉴权默认调用自身
USER_AUTH_ENDPOINT=http://studio-manager:31111
AGENT_BUILDER_ENDPOINT=http://studio-builder:31015
AGENT_MANAGER_ENDPOINT=http://studio-manager:31111

# ============ HTTPS证书配置（选填） ============
# 启用HTTPS时设 SERVER_SSL_ENABLED=true，并填写以下证书配置
SERVER_SSL_ENABLED=false
# Java服务证书配置
CB_CF_SERVER_KEYSTORE=
CB_CF_TRUST_KEYSTORE=
SERVER_SSL_TRUST_STORE_PASSWORD=
SERVER_SSL_KEY_STORE_PASSWORD=
SERVER_SSL_KEY_PASSWORD=
# runtime服务证书配置
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=
TLS_CERT_KEY_PASSWD=

# ============ 沙箱配置（选填） ============
# 远程沙箱地址（配置后启用沙箱模式，为空则沙箱不可用自动走 local）
SECURITY_SANDBOX_SERVER=
# 沙箱类型：aio / jiuwenbox
SECURITY_SANDBOX_TYPE=jiuwenbox
# 沙箱SSL验证
SECURITY_SANDBOX_SSL_VERIFY=false
# 沙箱空闲超时（秒）
SECURITY_SANDBOX_IDLE_TTL=600
# 沙箱执行超时（秒）
SECURITY_SANDBOX_TIMEOUT=300
# 沙箱隔离级别：system / session
SECURITY_SANDBOX_SCOPE=system

# ============ OpenSearch配置（选填，启用记忆库时必填） ============
# 格式: host:port，多节点用逗号分隔，如 host1:9200,host2:9200
OPENSEARCH_HOSTS=
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=false
OPENSEARCH_SSL_VERIFY=false

# ============ 记忆库配置（选填，默认关闭） ============
# 总开关，设为true启用记忆库功能
MEMORY_ENABLED=false
LONG_TERM_MEMORY_ENABLE=false
MEMORY_USER_PROFILE_ENABLE=false
# 记忆库抽取用的Embedding模型配置（启用记忆库时必填）
MEMORY_EMBEDDING_MODEL=bge-m3
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=
# 记忆库抽取用的LLM模型配置（启用记忆库时必填）
MEMORY_LLM_MODEL=
MEMORY_LLM_BASE_URL=
MEMORY_LLM_API_KEY=

# ============ OpenTelemetry 配置（选填，默认关闭） ============
# 总开关，设为true启用OTel trace上报
OTEL_ENABLED=false

# ============ 日志脱敏配置 ============
# 脱敏总开关：设为true开启所有脱敏（words + patterns），默认false
LOG_MASKED_ENABLED=false
# 正则脱敏：只替换匹配到的敏感内容，保留非敏感上下文
LOG_MASKED_PATTERNS=


# 日志转存目录，默认 /opt/cloud/logs/common_log_backup
BACKUP_COMMON_LOG_DIR=
# 源日志文件路径，默认 /opt/cloud/logs/common.log
BACKUP_COMMON_LOG_FILE=

# ============ 其他配置（选填） ============
# runtime服务 Uvicorn worker 数量，默认 CPU 核心数 + 1
GUNICORN_WORK_NUM=
# LLM API Key占位符（任意非空字符串即可）
IR_LLM_API_KEY=sk-placeholder
# 插件节点是否启用SSL验证
PLUGIN_SSL_API_CERT=false
# 工作流执行超时时间（秒）
WORKFLOW_EXECUTE_TIMEOUT=900
# koosearch服务地址
KOOSEARCH_ENDPOINT=
# 前端页面屏蔽节点类型
FRONT_PAGE_BLOCK_NODES=Sql,DataQuery,Agent
# 知识库共享开关
SHARE_KNOWLEDGE_ENABLED=true

# ===== 知识库模式（可选；默认值保持当前 LakeSearch 行为不变）=====
# 知识库来源模式：LakeSearch(默认，内置LakeSearch服务)/CUSTOM(对接外部LakeSearch，支持个人/企业知识库筛选)
KNOWLEDGE_SOURCE=LakeSearch
# LakeSearch 服务地址：CUSTOM 模式必填；默认空
KNOWLEDGE_LAKESEARCH_ENDPOINT=
# LakeSearch 鉴权方式：basic(默认)/none(无鉴权，如本地 mock)
KNOWLEDGE_LAKESEARCH_AUTH_MODE=basic
# 工作流异步任务开关
WORKFLOW_ASYNC_ENABLED=true
# 运行时API地址前缀（IP:Port格式），用于前端拼接API调用地址，如 100.93.15.185:31014
FRONT_PAGE_RUNTIME_HOST=
# 意图识别工作流开关
ENABLE_INTENT_WORKFLOW=true
# 系统默认的加解密方式，NO_OP_CIPHER-表示不加密
SYSTEM_CRYPT_NAME=NO_OP_CIPHER
# 多智能体调试详情
INSIGHT_EI_DEBUG_INFO_ENABLE=true
EXECUTION_STATE_STORAGE_MEDIUM=redis
# 插件工具url校验开关
ENABLE_TOOL_URL_CHECK=true

# ============ 日志详细模式（选填） ============
LOG_VERBOSE=true
# 是否启用资源管理的操作日志
STUDIO_OPERATION_LOG_SWITCH=false
# SSO 鉴权验证地址，填写后启用 SSO 远程鉴权，留空则使用默认简单鉴权
AUTH_SSO_VALIDATE_URL=
