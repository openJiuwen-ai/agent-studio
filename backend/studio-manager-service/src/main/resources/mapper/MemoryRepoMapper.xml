<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.openjiuwen.studio.agent.manager.mapper.MemoryRepoMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.openjiuwen.studio.agent.manager.entity.MemoryRepoEntity">
        <id column="id" property="id" jdbcType="VARCHAR"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="description" property="description" jdbcType="VARCHAR"/>
        <result column="icon" jdbcType="VARCHAR" property="icon"/>
        <result column="time_span" property="timeSpan" jdbcType="INTEGER"/>
        <result column="conversation_round" property="conversationRound" jdbcType="INTEGER"/>
        <result column="long_term_memory_strategies" property="longTermMemoryStrategies" jdbcType="VARCHAR" typeHandler="com.openjiuwen.studio.agent.manager.mapper.handler.LongTermMemoryStrategyHandler"/>
        <result column="memory_backend_type" property="memoryBackendType" jdbcType="VARCHAR"/>
        <result column="memory_service_instance_id" property="memoryServiceInstanceId" jdbcType="VARCHAR"/>
        <result column="scope_model_config" property="scopeModelConfig" jdbcType="VARCHAR"/>
        <result column="project_id" property="projectId" jdbcType="VARCHAR"/>
        <result column="workspace_id" property="workspaceId" jdbcType="VARCHAR"/>
        <result column="domain_id" property="domainId" jdbcType="VARCHAR"/>
        <result column="created_user_id" property="createdUserId" jdbcType="VARCHAR"/>
        <result column="created_user_name" property="createdUserName" jdbcType="VARCHAR"/>
        <result column="last_update_user_id" property="lastUpdateUserId" jdbcType="VARCHAR"/>
        <result column="last_update_user_name" property="lastUpdateUserName" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        id, name, description, icon, time_span, conversation_round,
        long_term_memory_strategies, memory_backend_type, memory_service_instance_id,
        scope_model_config, project_id, workspace_id, domain_id,
        created_user_id, created_user_name, last_update_user_id,
        last_update_user_name, create_time, update_time
    </sql>

    <!-- 插入记录 -->
    <insert id="insert" parameterType="com.openjiuwen.studio.agent.manager.entity.MemoryRepoEntity">
        INSERT INTO t_memory_repo (
            id, name, description, icon, time_span, conversation_round,
            long_term_memory_strategies, memory_backend_type, memory_service_instance_id,
            scope_model_config, project_id, workspace_id, domain_id,
            created_user_id, created_user_name, last_update_user_id, last_update_user_name
        ) VALUES (
                     #{id}, #{name}, #{description}, #{icon}, #{timeSpan}, #{conversationRound},
                     #{longTermMemoryStrategies,typeHandler=com.openjiuwen.studio.agent.manager.mapper.handler.LongTermMemoryStrategyHandler},
                     #{memoryBackendType}, #{memoryServiceInstanceId}, #{scopeModelConfig},
                     #{projectId}, #{workspaceId}, #{domainId},
                     #{createdUserId}, #{createdUserName}, #{lastUpdateUserId}, #{lastUpdateUserName}
                 )
    </insert>

    <!-- 根据ID删除 -->
    <delete id="deleteById" parameterType="java.lang.String">
        DELETE FROM t_memory_repo WHERE id = #{id}
    </delete>

    <delete id="deleteByIds">
        delete
        from t_memory_repo
        where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 更新记录 -->
    <update id="updateById" parameterType="com.openjiuwen.studio.agent.manager.entity.MemoryRepoEntity">
        UPDATE t_memory_repo
        <set>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="description != null and description != ''">
                description = #{description},
            </if>
            <if test="icon != null and icon != ''">
                icon = #{icon},
            </if>
            <if test="timeSpan != null and timeSpan != ''">
                time_span = #{timeSpan},
            </if>
            <if test="conversationRound != null and conversationRound != ''">
                conversation_round = #{conversationRound},
            </if>
            <if test="longTermMemoryStrategies != null and longTermMemoryStrategies != ''">
                long_term_memory_strategies = #{longTermMemoryStrategies,typeHandler=com.openjiuwen.studio.agent.manager.mapper.handler.LongTermMemoryStrategyHandler},
            </if>
            <if test="memoryBackendType != null and memoryBackendType != ''">
                memory_backend_type = #{memoryBackendType},
            </if>
            <if test="memoryServiceInstanceId != null">
                memory_service_instance_id = #{memoryServiceInstanceId},
            </if>
            <if test="scopeModelConfig != null">
                scope_model_config = #{scopeModelConfig},
            </if>
            <if test="lastUpdateUserId != null and lastUpdateUserId != ''">
                last_update_user_id = #{lastUpdateUserId},
            </if>
            <if test="lastUpdateUserName != null and lastUpdateUserName != ''">
                last_update_user_name = #{lastUpdateUserName},
            </if>
        </set>
        WHERE id = #{id} and project_id = #{projectId}
    </update>

    <!-- 根据ID查询 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM t_memory_repo
        WHERE id = #{id}
    </select>

    <!-- 根据ID和空间ID查询记忆库 -->
    <select id="selectByIdAndWorkspaceId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM t_memory_repo
        WHERE id = #{id}
        AND workspace_id = #{workspaceId}
    </select>

    <!-- 条件查询列表 -->
    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM t_memory_repo
        <where>
            <if test="projectId != null and projectId != ''">
                AND project_id = #{projectId}
            </if>
            <if test="workspaceId != null and workspaceId != ''">
                AND workspace_id = #{workspaceId}
            </if>
            <if test="domainId != null and domainId != ''">
                AND domain_id = #{domainId}
            </if>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="ids != null and ids.size() > 0">
                AND id IN
                <foreach collection="ids" item="id" open="(" separator="," close=")">
                    #{id, jdbcType=VARCHAR}
                </foreach>
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

</mapper>
