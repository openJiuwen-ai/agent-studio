{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "n8n Node Type Classification Schema",
  "description": "Complete classification of n8n node types for parsing to other agentic frameworks",
  "version": "1.0.0",
  "lastUpdated": "2026-02-02",
  
  "nodeCategories": {
    "trigger": {
      "description": "Nodes that start workflow execution",
      "identificationPatterns": [
        ".*Trigger$",
        ".*trigger$",
        "n8n-nodes-base.webhook",
        "n8n-nodes-langchain.chatTrigger",
        "n8n-nodes-langchain.mcpTrigger"
      ],
      "types": {
        "manual": ["n8n-nodes-base.manualWorkflowTrigger"],
        "webhook": ["n8n-nodes-base.webhook", "n8n-nodes-base.formTrigger"],
        "schedule": ["n8n-nodes-base.scheduleTrigger"],
        "ai_chat": ["n8n-nodes-langchain.chatTrigger"],
        "mcp": ["n8n-nodes-langchain.mcpTrigger"],
        "error": ["n8n-nodes-base.errorTrigger"],
        "subworkflow": ["n8n-nodes-base.executeWorkflowTrigger"],
        "app_specific": "Pattern: n8n-nodes-base.{service}Trigger"
      }
    },
    
    "core": {
      "description": "Logic, data processing, and control flow nodes",
      "types": {
        "code": ["n8n-nodes-base.code"],
        "conditional": ["n8n-nodes-base.if", "n8n-nodes-base.switch"],
        "data_flow": ["n8n-nodes-base.merge", "n8n-nodes-base.splitInBatches"],
        "data_transform": [
          "n8n-nodes-base.set",
          "n8n-nodes-base.filter",
          "n8n-nodes-base.sort",
          "n8n-nodes-base.limit",
          "n8n-nodes-base.aggregate",
          "n8n-nodes-base.splitOut",
          "n8n-nodes-base.removeDuplicates",
          "n8n-nodes-base.renameKeys",
          "n8n-nodes-base.summarize",
          "n8n-nodes-base.compareDatasets"
        ],
        "http": ["n8n-nodes-base.httpRequest", "n8n-nodes-base.graphql"],
        "timing": ["n8n-nodes-base.wait"],
        "subworkflow": ["n8n-nodes-base.executeWorkflow"],
        "response": ["n8n-nodes-base.respondToWebhook", "n8n-nodes-langchain.respondToChat"],
        "error_handling": ["n8n-nodes-base.stopAndError"],
        "utility": ["n8n-nodes-base.noOp", "n8n-nodes-base.debugHelper"],
        "file_ops": [
          "n8n-nodes-base.convertToFile",
          "n8n-nodes-base.extractFromFile",
          "n8n-nodes-base.readWriteFile",
          "n8n-nodes-base.compression"
        ],
        "format_conversion": [
          "n8n-nodes-base.html",
          "n8n-nodes-base.xml",
          "n8n-nodes-base.markdown"
        ],
        "crypto": ["n8n-nodes-base.crypto", "n8n-nodes-base.jwt", "n8n-nodes-base.totp"],
        "datetime": ["n8n-nodes-base.dateTime"]
      }
    },
    
    "ai_root": {
      "description": "Root nodes for AI/LangChain operations - these accept sub-node connections",
      "types": {
        "agent": ["n8n-nodes-langchain.agent"],
        "chain": [
          "n8n-nodes-langchain.chainLlm",
          "n8n-nodes-langchain.chainRetrievalQa",
          "n8n-nodes-langchain.chainSummarization"
        ],
        "classifier": [
          "n8n-nodes-langchain.informationExtractor",
          "n8n-nodes-langchain.textClassifier",
          "n8n-nodes-langchain.sentimentAnalysis"
        ],
        "code": ["n8n-nodes-langchain.code"],
        "vector_store": [
          "n8n-nodes-langchain.vectorStoreInMemory",
          "n8n-nodes-langchain.vectorStorePinecone",
          "n8n-nodes-langchain.vectorStoreSupabase",
          "n8n-nodes-langchain.vectorStoreQdrant",
          "n8n-nodes-langchain.vectorStorePgVector",
          "n8n-nodes-langchain.vectorStoreMilvus",
          "n8n-nodes-langchain.vectorStoreWeaviate",
          "n8n-nodes-langchain.vectorStoreMongoDBAtlas",
          "n8n-nodes-langchain.vectorStoreRedis",
          "n8n-nodes-langchain.vectorStoreZep",
          "n8n-nodes-langchain.vectorStoreAzureAISearch"
        ]
      },
      "acceptsSubnodeTypes": [
        "ai_languageModel",
        "ai_memory",
        "ai_tool",
        "ai_embedding",
        "ai_retriever",
        "ai_outputParser",
        "ai_document",
        "ai_textSplitter",
        "ai_vectorStore"
      ]
    },
    
    "ai_subnode": {
      "description": "Sub-nodes that connect to AI root nodes",
      "types": {
        "chat_models": {
          "connectionType": "ai_languageModel",
          "nodes": [
            {"type": "n8n-nodes-langchain.lmChatOpenAi", "provider": "openai"},
            {"type": "n8n-nodes-langchain.lmChatAnthropic", "provider": "anthropic"},
            {"type": "n8n-nodes-langchain.lmChatGoogleGemini", "provider": "google"},
            {"type": "n8n-nodes-langchain.lmChatAzureOpenAi", "provider": "azure"},
            {"type": "n8n-nodes-langchain.lmChatOllama", "provider": "ollama"},
            {"type": "n8n-nodes-langchain.lmChatGroq", "provider": "groq"},
            {"type": "n8n-nodes-langchain.lmChatMistralCloud", "provider": "mistral"},
            {"type": "n8n-nodes-langchain.lmChatDeepSeek", "provider": "deepseek"},
            {"type": "n8n-nodes-langchain.lmChatCohere", "provider": "cohere"},
            {"type": "n8n-nodes-langchain.lmChatAwsBedrock", "provider": "aws"},
            {"type": "n8n-nodes-langchain.lmChatGoogleVertex", "provider": "google_vertex"},
            {"type": "n8n-nodes-langchain.lmChatOpenRouter", "provider": "openrouter"},
            {"type": "n8n-nodes-langchain.lmChatXaiGrok", "provider": "xai"},
            {"type": "n8n-nodes-langchain.lmChatVercel", "provider": "vercel"}
          ]
        },
        "basic_models": {
          "connectionType": "ai_languageModel",
          "nodes": [
            {"type": "n8n-nodes-langchain.lmCohere", "provider": "cohere"},
            {"type": "n8n-nodes-langchain.lmOllama", "provider": "ollama"},
            {"type": "n8n-nodes-langchain.lmOpenHuggingFaceInference", "provider": "huggingface"}
          ]
        },
        "memory": {
          "connectionType": "ai_memory",
          "nodes": [
            {"type": "n8n-nodes-langchain.memoryBufferWindow", "storage": "in_memory"},
            {"type": "n8n-nodes-langchain.memoryRedisChat", "storage": "redis"},
            {"type": "n8n-nodes-langchain.memoryPostgresChat", "storage": "postgres"},
            {"type": "n8n-nodes-langchain.memoryMongoChat", "storage": "mongodb"},
            {"type": "n8n-nodes-langchain.memoryXata", "storage": "xata"},
            {"type": "n8n-nodes-langchain.memoryZep", "storage": "zep"},
            {"type": "n8n-nodes-langchain.memoryMotorhead", "storage": "motorhead"},
            {"type": "n8n-nodes-langchain.memoryManager", "storage": "manager"}
          ]
        },
        "embeddings": {
          "connectionType": "ai_embedding",
          "nodes": [
            {"type": "n8n-nodes-langchain.embeddingsOpenAi", "provider": "openai"},
            {"type": "n8n-nodes-langchain.embeddingsAzureOpenAi", "provider": "azure"},
            {"type": "n8n-nodes-langchain.embeddingsGoogleGemini", "provider": "google"},
            {"type": "n8n-nodes-langchain.embeddingsGoogleVertex", "provider": "google_vertex"},
            {"type": "n8n-nodes-langchain.embeddingsGooglePalm", "provider": "google_palm"},
            {"type": "n8n-nodes-langchain.embeddingsCohere", "provider": "cohere"},
            {"type": "n8n-nodes-langchain.embeddingsOllama", "provider": "ollama"},
            {"type": "n8n-nodes-langchain.embeddingsHuggingFaceInference", "provider": "huggingface"},
            {"type": "n8n-nodes-langchain.embeddingsAwsBedrock", "provider": "aws"},
            {"type": "n8n-nodes-langchain.embeddingsMistralCloud", "provider": "mistral"}
          ]
        },
        "tools": {
          "connectionType": "ai_tool",
          "nodes": [
            {
              "type": "n8n-nodes-langchain.toolCalculator",
              "category": "builtin",
              "description": "Mathematical calculations"
            },
            {
              "type": "n8n-nodes-langchain.toolCode",
              "category": "custom",
              "description": "Custom JavaScript/Python code as tool",
              "keyParams": ["jsCode", "name", "description"]
            },
            {
              "type": "n8n-nodes-langchain.toolHttpRequest",
              "category": "api",
              "description": "HTTP API calls as tool",
              "keyParams": ["url", "method", "description", "toolDescription"]
            },
            {
              "type": "n8n-nodes-langchain.toolWorkflow",
              "category": "workflow",
              "description": "Call n8n workflow as tool",
              "keyParams": ["workflowId", "name", "description"]
            },
            {
              "type": "n8n-nodes-langchain.toolWikipedia",
              "category": "search",
              "description": "Wikipedia search"
            },
            {
              "type": "n8n-nodes-langchain.toolSerpApi",
              "category": "search",
              "description": "Google search via SerpAPI",
              "keyParams": ["country", "language"]
            },
            {
              "type": "n8n-nodes-langchain.toolWolframAlpha",
              "category": "computation",
              "description": "Wolfram Alpha queries"
            },
            {
              "type": "n8n-nodes-langchain.toolVectorStore",
              "category": "retrieval",
              "description": "Vector store Q&A tool",
              "keyParams": ["name", "description"]
            },
            {
              "type": "n8n-nodes-langchain.toolMcp",
              "category": "protocol",
              "description": "MCP client for external tools",
              "keyParams": ["sseEndpoint", "toolsToInclude"]
            },
            {
              "type": "n8n-nodes-langchain.toolSearxng",
              "category": "search",
              "description": "SearXNG metasearch"
            },
            {
              "type": "n8n-nodes-langchain.toolThink",
              "category": "reasoning",
              "description": "Explicit reasoning step"
            },
            {
              "type": "n8n-nodes-langchain.toolAiAgent",
              "category": "agent",
              "description": "Nested agent as tool",
              "keyParams": ["agentDescription"]
            }
          ]
        },
        "document_loaders": {
          "connectionType": "ai_document",
          "nodes": [
            {"type": "n8n-nodes-langchain.documentDefaultDataLoader"},
            {"type": "n8n-nodes-langchain.documentGitHubLoader"}
          ]
        },
        "text_splitters": {
          "connectionType": "ai_textSplitter",
          "nodes": [
            {"type": "n8n-nodes-langchain.textSplitterCharacterTextSplitter"},
            {"type": "n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter"},
            {"type": "n8n-nodes-langchain.textSplitterTokenSplitter"}
          ]
        },
        "retrievers": {
          "connectionType": "ai_retriever",
          "nodes": [
            {"type": "n8n-nodes-langchain.retrieverVectorStore"},
            {"type": "n8n-nodes-langchain.retrieverMultiQuery"},
            {"type": "n8n-nodes-langchain.retrieverContextualCompression"},
            {"type": "n8n-nodes-langchain.retrieverWorkflow"}
          ]
        },
        "output_parsers": {
          "connectionType": "ai_outputParser",
          "nodes": [
            {"type": "n8n-nodes-langchain.outputParserStructured"},
            {"type": "n8n-nodes-langchain.outputParserItemList"},
            {"type": "n8n-nodes-langchain.outputParserAutoFixing"}
          ]
        },
        "other": {
          "nodes": [
            {"type": "n8n-nodes-langchain.rerankerCohere", "connectionType": "ai_reranker"},
            {"type": "n8n-nodes-langchain.modelSelector", "connectionType": "ai_languageModel"}
          ]
        }
      }
    },
    
    "app_action": {
      "description": "Service integration nodes for specific apps",
      "pattern": "n8n-nodes-base.{serviceName}",
      "commonServices": [
        "slack", "gmail", "notion", "airtable", "googleSheets", 
        "postgres", "mongodb", "mysql", "redis",
        "github", "gitlab", "jira", "linear",
        "discord", "telegram", "whatsapp",
        "openai", "anthropic", "googleGemini",
        "stripe", "shopify", "woocommerce",
        "salesforce", "hubspot", "pipedrive",
        "aws*", "google*", "microsoft*"
      ]
    }
  },
  
  "connectionTypes": {
    "main": {
      "description": "Standard data flow between nodes",
      "direction": "output -> input"
    },
    "ai_languageModel": {
      "description": "LLM model connection to AI root nodes",
      "subnodeTypes": ["chat_models", "basic_models"]
    },
    "ai_memory": {
      "description": "Memory connection for conversation context",
      "subnodeTypes": ["memory"]
    },
    "ai_tool": {
      "description": "Tool connections for AI agents",
      "subnodeTypes": ["tools"],
      "note": "Multiple tools can connect as array entries"
    },
    "ai_embedding": {
      "description": "Embedding model connection",
      "subnodeTypes": ["embeddings"]
    },
    "ai_retriever": {
      "description": "Retriever connection for RAG",
      "subnodeTypes": ["retrievers"]
    },
    "ai_outputParser": {
      "description": "Output parser for structured responses",
      "subnodeTypes": ["output_parsers"]
    },
    "ai_document": {
      "description": "Document loader connection",
      "subnodeTypes": ["document_loaders"]
    },
    "ai_textSplitter": {
      "description": "Text splitter for chunking",
      "subnodeTypes": ["text_splitters"]
    },
    "ai_vectorStore": {
      "description": "Vector store connection",
      "subnodeTypes": ["vector_store"]
    }
  },
  
  "workflowStructure": {
    "rootFields": [
      "name",
      "nodes",
      "connections", 
      "pinData",
      "settings",
      "staticData",
      "tags",
      "triggerCount",
      "updatedAt",
      "versionId"
    ],
    "nodeFields": [
      "id",
      "name",
      "type",
      "typeVersion",
      "position",
      "parameters",
      "credentials",
      "disabled",
      "notesInFlow",
      "notes"
    ]
  },
  
  "frameworkMapping": {
    "langchain": {
      "agent": "AgentExecutor",
      "chainLlm": "LLMChain",
      "chainRetrievalQa": "RetrievalQA",
      "lmChatOpenAi": "ChatOpenAI",
      "lmChatAnthropic": "ChatAnthropic",
      "memoryBufferWindow": "ConversationBufferWindowMemory",
      "toolCode": "StructuredTool",
      "toolHttpRequest": "RequestsGetTool / RequestsPostTool",
      "vectorStorePinecone": "Pinecone"
    },
    "crewai": {
      "agent": "Agent",
      "toolCode": "Tool",
      "toolHttpRequest": "Tool",
      "lmChatOpenAi": "ChatOpenAI"
    },
    "autogen": {
      "agent": "AssistantAgent",
      "toolCode": "function",
      "lmChatOpenAi": "OpenAI config"
    }
  }
}
