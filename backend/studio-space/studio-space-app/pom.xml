        </dependency>
        <dependency>
            <groupId>com.openjiuwen</groupId>
            <artifactId>studio-space-api</artifactId>
            <version>0.0.1</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.openjiuwen</groupId>
            <artifactId>studio-common</artifactId>
            <version>0.0.1</version>
            <scope>compile</scope>
