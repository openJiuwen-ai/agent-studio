###############################################################################
# L2 跨节点日志聚合 — 统一配置
###############################################################################
# 复制为 .env 后按需修改。监控节点和 app 节点共用同一模板；
# deploy-monitor.sh / deploy-vector.sh 首次运行都会自动复制。

# ── app 节点 Vector ──
# 每个 app 节点使用不同的 NODE_NAME，作为日志 host 标签。
NODE_NAME=node-1

# app 服务 Compose project 名，用于定位 deploy_manager_logs 等命名卷。
APP_PROJECT_NAME=deploy
# L2 两套 Compose 使用不同 project，避免同机演练时 stop 误删另一套容器。
MONITOR_PROJECT_NAME=observability-monitor
VECTOR_PROJECT_NAME=observability-agent

# ── 日志存储：VictoriaLogs（本地存储，无对象存储依赖）──
# 日志保留周期，VictoriaLogs duration 格式，例如 3d、7d、1y。
VICTORIA_LOGS_RETENTION=7d
# 0 表示不限制；生产建议按磁盘容量设置，例如 107374182400（100 GiB）。
VICTORIA_LOGS_MAX_DISK_USAGE_BYTES=0

# ── Gateway TLS 与读写分离鉴权 ──
# LOGS_GATEWAY_HOST 必须与证书 SAN 一致；首次启动会生成自签名证书。
LOGS_WRITE_USER=logs-write
LOGS_WRITE_PASSWORD=change-write-password
LOGS_QUERY_USER=logs-query
LOGS_QUERY_PASSWORD=change-query-password
LOGS_GATEWAY_HTTPS_PORT=3100
LOGS_GATEWAY_CERT_DAYS=825

# app 节点填写监控节点实际地址；监控节点自身可保留占位值。
LOGS_GATEWAY_HOST=monitor.example.com

# ── Grafana ──
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# 定制 Grafana 镜像：可填写完整地址，或填写 GHCR 仓库前缀由脚本派生。
# GHCR_IMAGE_REPOSITORY=ghcr.io/<owner>/<repository>
GHCR_IMAGE_REPOSITORY=
GRAFANA_IMAGE_TAG=11.3.0-0.29.0
GRAFANA_IMAGE=

# ── 镜像（离线部署可改本地 load 的镜像名）──
# VICTORIA_LOGS_IMAGE=victoriametrics/victoria-logs:v1.50.0
# VECTOR_IMAGE=timberio/vector:0.55.0-alpine
# VECTOR_BUFFER_MAX_SIZE=1073741824
# NGINX_IMAGE=nginx:1.27-alpine
