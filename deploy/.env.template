###############################################################################
# Image source
###############################################################################
# Choose where application images come from:
#   ghcr      -> pull from GHCR: ${GHCR_IMAGE_REPOSITORY}/studio-manager:${IMAGE_TAG}
#   dockerhub -> pull from Docker Hub: ${DOCKERHUB_IMAGE_REPOSITORY}:studio-manager-${IMAGE_TAG}
#   offline   -> load from local images/*.tar files; STUDIO_*_IMAGE must be set below
#   custom    -> use explicit STUDIO_*_IMAGE values below
IMAGE_SOURCE=ghcr
IMAGE_TAG=latest

# Required for the selected online source. Examples:
# GHCR_IMAGE_REPOSITORY=ghcr.io/<owner>/<repository>
# DOCKERHUB_IMAGE_REPOSITORY=<owner>/<repository>
GHCR_IMAGE_REPOSITORY=
DOCKERHUB_IMAGE_REPOSITORY=

# Optional registry credentials. Leave blank for public images.
GHCR_USERNAME=
GHCR_TOKEN=
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Only required when IMAGE_SOURCE=offline or IMAGE_SOURCE=custom.
# For offline, prepare.sh fills TAG_PLACEHOLDER automatically.
# STUDIO_CONSOLE_IMAGE=studio-console:TAG_PLACEHOLDER
# STUDIO_MANAGER_IMAGE=studio-manager:TAG_PLACEHOLDER
# STUDIO_RUNTIME_IMAGE=studio-runtime:TAG_PLACEHOLDER
# STUDIO_BUILDER_IMAGE=studio-builder:TAG_PLACEHOLDER

###############################################################################
# Infrastructure images
###############################################################################
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:7
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest

###############################################################################
# Service ports (optional, defaults below)
###############################################################################
CONSOLE_PORT=80
MANAGER_PORT=31111
RUNTIME_PORT=31014
BUILDER_PORT=31015

###############################################################################
# Infrastructure ports (optional, only for built-in infrastructure)
###############################################################################
# ⚠️ 安全提示：以下端口会直接发布到宿主机。默认口令为弱口令（数据库 123456、
# MinIO minioadmin/minioadmin、OpenSearch admin/admin）。若宿主机处于公网或
# 不可信网络，请务必：1) 修改默认口令；或 2) 留空对应 *_PORT 以不对外发布。
DB_PORT=3306
REDIS_EXTERNAL_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

###############################################################################
# Database (required)
###############################################################################
# Built-in infrastructure defaults work out of the box.
# For external databases, replace IP and credentials.
# MySQL:   jdbc:mariadb://<HOST>:3306/<DB_NAME>?allowMultiQueries=true
# GaussDB: jdbc:opengauss://<HOST1>:8000,<HOST2>:8000,<HOST3>:8000/<DB_NAME>?targetServerType=master
SPRING_DATASOURCE_URL=jdbc:mariadb://mysql:3306/agent-builder?allowMultiQueries=true&useUnicode=true&characterEncoding=UTF-8&autoReconnect=true&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=123456
# For GaussDB, uncomment the following line:
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.huawei.opengauss.jdbc.Driver

###############################################################################
# Redis (required)
###############################################################################
# Single: REDIS_HOST + REDIS_PORT + REDIS_PASSWORD
# Cluster: REDIS_CLUSTER_NODES + REDIS_PASSWORD + REDIS_MODE=cluster
# Sentinel: REDIS_HOST + REDIS_SENTINEL_MASTER + REDIS_SENTINEL_PORTS + REDIS_SENTINEL_NODES + REDIS_PASSWORD + REDIS_MODE=sentinel
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MODE=single
REDIS_DATABASE=0
REDIS_CLUSTER_NODES=
REDIS_SENTINEL_MASTER=
REDIS_SENTINEL_PORTS=
REDIS_SENTINEL_NODES=
# Redis pipeline 事务开关，true 使用标准事务，false 使用非事务
REDIS_TRANSACTION_ENABLED=true

# Runtime internal port (optional, generally matches RUNTIME_PORT)
# SERVER_PORT=31014

###############################################################################
# Object storage (required)
###############################################################################
# Built-in infrastructure defaults work out of the box.
# MinIO:    http://<MINIO_IP>:9000
# Cloud OBS: https://<OBS_ENDPOINT>:443
OBS_URL=http://minio:9000
# Bucket name. When using built-in MinIO, docker-compose.yml adds a DNS alias
# <OBS_BUCKET>.minio on the container network so that OBS SDK virtual-hosted-style
# requests (e.g. http://agent-builder.minio:9000/) resolve correctly.
OBS_BUCKET=agent-builder
OBS_AK=minioadmin
OBS_SK=minioadmin
DATASOURCE_OBS_ENABLE_SSL=false
# Object storage addressing style: path (path-style, default) or virtual (virtual-hosted-style)
DATASOURCE_OBS_PATH_STYLE=path

###############################################################################
# Service endpoints (defaults work for single-node deployment)
###############################################################################
# Change to https if SSL is enabled
AGENT_RUNTIME_ENDPOINT=http://studio-runtime:31014
USER_AUTH_ENDPOINT=http://studio-manager:31111
AGENT_MANAGER_ENDPOINT=http://studio-manager:31111
AGENT_BUILDER_ENDPOINT=http://studio-builder:31015
# Runtime 默认通过 MODEL_CONFIG_STRATEGY=obs 直连模型，不再配置旧 MODEL_ROUTER_API。

###############################################################################
# TLS settings (optional, defaults keep HTTP)
###############################################################################
SERVER_SSL_ENABLED=false
# Java service certificates
CB_CF_SERVER_KEYSTORE=
CB_CF_TRUST_KEYSTORE=
SERVER_SSL_TRUST_STORE_PASSWORD=
SERVER_SSL_KEY_STORE_PASSWORD=
SERVER_SSL_KEY_PASSWORD=
# Runtime service certificates
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=
TLS_CERT_KEY_PASSWD=

###############################################################################
# Sandbox settings (optional)
###############################################################################
SECURITY_SANDBOX_SERVER=
# Sandbox type: aio / jiuwenbox
SECURITY_SANDBOX_TYPE=jiuwenbox
SECURITY_SANDBOX_SSL_VERIFY=false
SECURITY_SANDBOX_IDLE_TTL=600
SECURITY_SANDBOX_TIMEOUT=300
SECURITY_SANDBOX_SCOPE=system

###############################################################################
# OpenSearch settings (optional, required for memory feature)
###############################################################################
OPENSEARCH_HOSTS=
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=false
OPENSEARCH_SSL_VERIFY=false

###############################################################################
# Memory feature settings (optional, disabled by default)
###############################################################################
MEMORY_ENABLED=false
LONG_TERM_MEMORY_ENABLE=false
MEMORY_USER_PROFILE_ENABLE=false
MEMORY_EMBEDDING_MODEL=bge-m3
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=
MEMORY_LLM_MODEL=
MEMORY_LLM_BASE_URL=
MEMORY_LLM_API_KEY=

###############################################################################
# Memory MySQL storage (optional, required when memory is enabled)
###############################################################################
MEMORY_DB_HOST=
MEMORY_DB_PORT=3306
MEMORY_DB_USER=
MEMORY_DB_PASSWORD=
MEMORY_DB_NAME=agent-memory

###############################################################################
# Pull policy (optional, auto-set by deploy.sh based on IMAGE_SOURCE)
###############################################################################
# APP_PULL_POLICY=always

###############################################################################
# Builder prompt-optimization persistence (STORE_DB_*)
###############################################################################
# studio-builder 启动时会初始化关系库存储，代码读取 STORE_DB_* 前缀。
# 使用内置 MySQL 时下方默认值即可；用户名/密码复用 SPRING_DATASOURCE_USERNAME / SPRING_DATASOURCE_PASSWORD。
# 若改用 GaussDB：STORE_DB_TYPE=gaussdb，并确认 py-opengauss / psycopg2 已安装。
STORE_DB_TYPE=mysql
STORE_DB_HOST=mysql
STORE_DB_PORT=3306
STORE_DB_DATABASE=agent-builder
STORE_DB_SSLMODE=disable

###############################################################################
# Workflow async (optional)
###############################################################################
WORKFLOW_ASYNC_ENABLED=true

###############################################################################
# Runtime worker & telemetry (optional)
###############################################################################
GUNICORN_WORK_NUM=1     # Uvicorn worker count, default: 1
# OTEL_ENABLED=false    # OpenTelemetry trace reporting

###############################################################################
# Other settings (optional)
###############################################################################
IR_LLM_API_KEY=sk-placeholder
PLUGIN_SSL_API_CERT=false
WORKFLOW_EXECUTE_TIMEOUT=900
KOOSEARCH_ENDPOINT=
FRONT_PAGE_BLOCK_NODES=Sql,DataQuery,Agent
SHARE_KNOWLEDGE_ENABLED=true
# 非图片文件上传大小上限（单位 KB，默认 131072 即 128MB）
# 同时控制聊天附件上传和智能体/工作流导入包大小
AGENT_MAX_UPLOAD_FILE_SIZE=131072
# 用户上传文件累计大小上限（单位 KB，默认 204800 即 200MB，按用户 24 小时窗口累计）
MAX_UPLOAD_TOTAL_SIZE=204800
# 引用未发布插件：默认关闭，置 true 时允许引用未发布的插件
PLUGIN_PUBLISH_CHOICE=false

###############################################################################
# Knowledge base mode (optional; defaults keep current LakeSearch behavior)
###############################################################################
# 知识库来源模式：LakeSearch(默认，内置LakeSearch服务)/CUSTOM(对接外部LakeSearch，支持个人/企业知识库筛选)
KNOWLEDGE_SOURCE=LakeSearch
# LakeSearch 服务地址：CUSTOM 模式必填；默认空
KNOWLEDGE_LAKESEARCH_ENDPOINT=
# LakeSearch 鉴权方式：basic(默认)/none(无鉴权，如本地 mock)
KNOWLEDGE_LAKESEARCH_AUTH_MODE=basic

###############################################################################
# Observability: 日志聚合栈（可选；profiles: logging）
###############################################################################
# 默认部署（infra/start）不会启动日志栈，需手动执行：./deploy.sh logging
# 启动后五个 app 服务（manager/service/runtime/builder/console）的日志由 Vector 采集到 VictoriaLogs，
# 在 Grafana 中查询，免去跨容器 grep。详见 config/observability-readme.md。
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# ⚠️ 生产环境请务必修改默认口令
GRAFANA_ADMIN_PASSWORD=admin

# VictoriaLogs 日志保留周期。默认 7 天。
VICTORIA_LOGS_RETENTION=7d
VICTORIA_LOGS_MAX_DISK_USAGE_BYTES=10737418240
VICTORIA_LOGS_MIN_FREE_DISK_BYTES=2147483648
APP_LOG_TIMEZONE=Asia/Shanghai

# Docker stdout/stderr 本地轮转：每容器默认最多约 500 MiB（100 MiB × 5）。
DOCKER_LOG_MAX_SIZE=100m
DOCKER_LOG_MAX_FILES=5

# 监控栈镜像（离线部署时可在 .env 中改为本地 load 的镜像名）
VICTORIA_LOGS_IMAGE=victoriametrics/victoria-logs:v1.50.0
VECTOR_IMAGE=timberio/vector:0.55.0-alpine
VECTOR_BUFFER_MAX_SIZE=1073741824
# GHCR 模式默认由 deploy.sh 解析为：
# ${GHCR_IMAGE_REPOSITORY}/grafana-victorialogs:${GRAFANA_IMAGE_TAG}
# Docker Hub/custom 模式可显式填写完整地址；离线包会自动写入本地镜像名。
GRAFANA_IMAGE_TAG=11.3.0-0.29.0
GRAFANA_IMAGE=
# MONITOR_PULL_POLICY=if_not_present

###############################################################################
# SSO authentication (optional, disabled by default)
###############################################################################
# SSO 鉴权验证地址，填写后启用 SSO 远程鉴权，留空则使用默认简单鉴权
AUTH_SSO_VALIDATE_URL=

###############################################################################
# 客户 Header rename（默认关闭，启用后 cust-* 去掉前缀传给下游）
###############################################################################
CUSTOMER_HEADER_ENABLED=false
# 映射规则：from:to 逗号分隔，所有下游共享
CUSTOMER_HEADER_MAPPINGS=cust-userid:userId,cust-token:token
