# 强制源码文本文件用 LF 换行——core.autocrlf=true 下 Windows checkout 会把文本转成
# CRLF，build.ps1 读 working tree 打进 zip 后，Linux 上 bash 执行 *.sh、`.` 加载 *.env、
# sed 处理 *.tmpl 都会因 \r 报错（/usr/bin/env bash^M / 命令未找到 \r）。强制 LF 杜绝此隐患。
# （.cache/.build/dist 为构建产物且 gitignore，不受影响。）
*.sh     text eol=lf
*.ps1    text eol=lf
*.py     text eol=lf
*.env    text eol=lf
*.template text eol=lf
*.tmpl   text eol=lf
*.sql    text eol=lf
*.yml    text eol=lf
*.xml    text eol=lf
*.yaml   text eol=lf
*.conf   text eol=lf
*.txt    text eol=lf
*.md     text eol=lf
