###############################################################################
# native-install/versions.arm64.env  —  ARM64(aarch64) 原生依赖下载源（单一真相源）
###############################################################################
# 供 build_arm64.sh 使用，与 versions.env（x86_64）平行的 ARM 版本源。SHA256 留空跳过校验。
#
# 与 x86 侧的关键差异（皆有客观原因，非偷懒）：
#  - MySQL：官方 aarch64 仅有 glibc2.28 全量包（无 minimal 变体），自 8.0.46 起提供。
#    故 ARM 包基线为 glibc 2.28+（x86 包为 2.17+）。全量包解压后由构建脚本裁剪
#    （去 mysql-test/docs/man/include/静态库/mysqld-debug）逼近 minimal 体积。
#    国内镜像（阿里/腾讯/华为云/南大）均未同步 aarch64 tarball，只能走官方 CDN
#    （单连接 ~80KB/s，构建脚本对大文件做 16 并发分块下载）。
#  - Linux Redis：不用 Remi el7 RPM（无 aarch64），改源码编译——零外部依赖仅链 glibc，
#    且从源头避开 Remi 包链 libssl.so.10 的兜底问题（x86 侧因此要捆 openssl-libs）。
#  - nginx：源码编译（pcre2+zlib 静态捆绑，同 x86 侧 fetch_deps.sh 配方）。
#  - 编译容器 debian:10（glibc 2.28，EOL 后 apt 源须指 archive.debian.org），
#    保证编译产物符号版本 ≤2.28，与 MySQL 基线一致。
#  - 兼容库取 centos-altarch（CentOS7 ARM 官方树）el7 aarch64 RPM：glibc2.17 老库
#    向后兼容，soname 与 x86 侧一致（libaio.so.1/libnuma.so.1/libncurses.so.5/libtinfo.so.5）。
###############################################################################

# ── 构建产物版本号（与 x86 包保持同版）────────────────────────────────────────
BUNDLE_NAME=AgentStudio
BUNDLE_VERSION=1.1.0

# ── GitHub 加速镜像（同 versions.env）─────────────────────────────────────────
GITHUB_MIRROR=https://ghfast.top/

# ── 编译容器（须 arm64 + glibc ≤ 2.28）────────────────────────────────────────
COMPILE_IMAGE=debian:10

# ── JRE 17 (Temurin aarch64) ─────────────────────────────────────────────────
# 用清华 Adoptium 镜像：ghfast.top 对大文件资产时好时坏（实测同日多次 60s 超时），
# 清华实测 ~3MB/s 且支持 Range。清华仅保留最新版 → JRE 为 17.0.20.1+1（x86 包为 17.0.13+11，
# JRE 向后兼容同一 Java17 jar，版本漂移无害）。
JRE17_VERSION=17.0.20.1+1
JRE17_LINUX_URL=https://mirrors.tuna.tsinghua.edu.cn/Adoptium/17/jre/aarch64/linux/OpenJDK17U-jre_aarch64_linux_hotspot_17.0.20.1_1.tar.gz
JRE17_LINUX_SHA256=

# ── MySQL 8.0（aarch64 官方仅 glibc2.28 全量包，无 minimal；8.0.46 起提供）────
MYSQL_VERSION=8.0.46
MYSQL_LINUX_URL=https://cdn.mysql.com//Downloads/MySQL-8.0/mysql-8.0.46-linux-glibc2.28-aarch64.tar.xz
MYSQL_LINUX_SHA256=

# ── Redis 7（源码编译；el7 el7 预编译 RPM 无 aarch64）────────────────────────
REDIS_VERSION=7.0.14
REDIS_LINUX_URL=https://download.redis.io/releases/redis-7.0.14.tar.gz
REDIS_LINUX_SHA256=

# ── MinIO server + mc（单文件二进制，linux-arm64）─────────────────────────────
MINIO_LINUX_URL=https://dl.minio.org.cn/server/minio/release/linux-arm64/minio
MINIO_LINUX_SHA256=
MC_LINUX_URL=https://dl.minio.org.cn/client/mc/release/linux-arm64/mc
MC_LINUX_SHA256=

# ── Python 3.11 (python-build-standalone aarch64，自带 pip) ────────────────────
PYTHON_VERSION=3.11.15
PYBUILD_TAG=20260718
PYTHON_LINUX_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20260718/cpython-3.11.15+20260718-aarch64-unknown-linux-gnu-install_only_stripped.tar.gz
PYTHON_LINUX_SHA256=

# ── nginx（源码编译）+ pcre2/zlib 源码（静态编进 nginx）───────────────────────
NGINX_VERSION=1.26.3
NGINX_LINUX_URL=https://nginx.org/download/nginx-1.26.3.tar.gz
NGINX_LINUX_SHA256=
PCRE2_URL=https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.43/pcre2-10.43.tar.gz
PCRE2_SHA256=
ZLIB_URL=https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz
ZLIB_SHA256=

# ── Linux 兼容库（centos-altarch el7 aarch64，glibc 2.17，缺库目标机兜底）─────
# mysqld 需 libaio.so.1/libnuma.so.1；mysql 客户端需 libncurses.so.5/libtinfo.so.5。
# ARM 侧 redis 为源码编译仅链 glibc，无需 libssl.so.10 兜底（x86 侧 Remi RPM 才需要）。
NCURSES_LIBS_URL=https://mirrors.aliyun.com/centos-altarch/7.9.2009/os/aarch64/Packages/ncurses-libs-5.9-14.20130511.el7_4.aarch64.rpm
NCURSES_LIBS_SHA256=
LIBAIO_URL=https://mirrors.aliyun.com/centos-altarch/7.9.2009/os/aarch64/Packages/libaio-0.3.109-13.el7.aarch64.rpm
LIBAIO_SHA256=
NUMACTL_LIBS_URL=https://mirrors.aliyun.com/centos-altarch/7.9.2009/os/aarch64/Packages/numactl-libs-2.0.12-5.el7.aarch64.rpm
NUMACTL_LIBS_SHA256=

# ── pip 离线 wheel 下载（aarch64 原生解析在编译容器内完成）────────────────────
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com
