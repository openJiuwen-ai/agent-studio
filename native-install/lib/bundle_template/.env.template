###############################################################################
# openJiuwen AgentStudio — 原生（免容器）模式 .env
###############################################################################
# 所有服务在本机以原生进程运行，相互访问用 127.0.0.1 + 端口。
# 首次启动脚本会从 .env.template 复制为 .env；按需改端口/口令后重启即可。
###############################################################################

# ── 服务端口 ───────────────────────────────────────────────────────────────
CONSOLE_PORT=80
MANAGER_PORT=31111
RUNTIME_PORT=31014
BUILDER_PORT=31015

# ── 基础设施端口 ─────────────────────────────────────────────────────────────
DB_PORT=3306
REDIS_EXTERNAL_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# ⚠️ 安全：默认弱口令（DB 123456、MinIO minioadmin/minioadmin）。公网/不可信网络请务必改口令。

# ── 数据库 (MySQL) ───────────────────────────────────────────────────────────
# 注意：值含 &（JDBC 查询参数），bash `source .env` 会把 & 当后台化 → 变量丢失。
# 必须双引号包裹（start.ps1 解析时会剥掉首尾双引号）。
SPRING_DATASOURCE_URL="jdbc:mariadb://127.0.0.1:3306/agent-builder?allowMultiQueries=true&useUnicode=true&characterEncoding=UTF-8&autoReconnect=true&allowPublicKeyRetrieval=true"
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=123456
# 若用 GaussDB，取消下行注释：
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.huawei.opengauss.jdbc.Driver

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MODE=single
REDIS_DATABASE=0

# ── 对象存储 (MinIO) ─────────────────────────────────────────────────────────
OBS_URL=http://127.0.0.1:9000
OBS_BUCKET=agent-builder
OBS_AK=minioadmin
OBS_SK=minioadmin
# Python 侧（agent_runtime/agent_builder 的 pydantic settings）读 DATASOURCE_OBS_* 前缀，
# 与上面 OBS_* 同值；两者都导出到进程环境。
DATASOURCE_OBS_SERVER=http://127.0.0.1:9000
DATASOURCE_OBS_BUCKET=agent-builder
DATASOURCE_OBS_AK=minioadmin
DATASOURCE_OBS_SK=minioadmin
DATASOURCE_OBS_ENABLE_SSL=false
DATASOURCE_OBS_PATH_STYLE=path
# Python 侧存储/模型配置策略：OBS（默认）；与 docker-compose 对齐
STORAGE_TYPE=OBS
MODEL_CONFIG_STRATEGY=obs

# ── 服务端点（单机原生，均指向本机）──────────────────────────────────────
# 新架构（docker 侧同步）：manager(Java 31111)、runtime(Python 31014)、builder(Python 31015)。
AGENT_RUNTIME_ENDPOINT=http://127.0.0.1:31014
AGENT_BUILDER_ENDPOINT=http://127.0.0.1:31015
USER_AUTH_ENDPOINT=http://127.0.0.1:31111
AGENT_MANAGER_ENDPOINT=http://127.0.0.1:31111
JIUWEN_BASE_URL=http://127.0.0.1:31014

# ── TLS（默认 HTTP）──────────────────────────────────────────────────────────
SERVER_SSL_ENABLED=false
# runtime(Python agent_builder) 的 settings.yaml 硬编码 https:True；env_to_config 用
# 环境变量 HTTPS 覆盖它（json.loads("false")→False 才能真正关 SSL，字符串 "false" 反为真）。
# 不设则 runtime 启动建 SSL 上下文时因无证书崩：SslCreateException: Certificate and key must be strings.
HTTPS=false
CB_CF_SERVER_KEYSTORE=
CB_CF_TRUST_KEYSTORE=
SERVER_SSL_TRUST_STORE_PASSWORD=
SERVER_SSL_KEY_STORE_PASSWORD=
SERVER_SSL_KEY_PASSWORD=
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=
TLS_CERT_KEY_PASSWD=

# ── Sandbox（可选）───────────────────────────────────────────────────────────
SECURITY_SANDBOX_SERVER=
SECURITY_SANDBOX_TYPE=jiuwenbox
SECURITY_SANDBOX_SSL_VERIFY=false
SECURITY_SANDBOX_IDLE_TTL=600
SECURITY_SANDBOX_TIMEOUT=300
SECURITY_SANDBOX_SCOPE=system

# ── OpenSearch / Memory（可选，默认关闭）────────────────────────────────────
OPENSEARCH_HOSTS=
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=false
OPENSEARCH_SSL_VERIFY=false
MEMORY_ENABLED=false
LONG_TERM_MEMORY_ENABLE=false
MEMORY_USER_PROFILE_ENABLE=false
MEMORY_EMBEDDING_MODEL=bge-m3
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=
MEMORY_LLM_MODEL=
MEMORY_LLM_BASE_URL=
MEMORY_LLM_API_KEY=
MEMORY_DB_HOST=
MEMORY_DB_PORT=3306
MEMORY_DB_USER=
MEMORY_DB_PASSWORD=
MEMORY_DB_NAME=agent-memory

# ── Runtime 关系库存储（agent_builder 启动时初始化，复用上方 DB 口令）──────
STORE_DB_TYPE=mysql
STORE_DB_HOST=127.0.0.1
STORE_DB_PORT=3306
STORE_DB_DATABASE=agent-builder
STORE_DB_SSLMODE=disable

# ── Workflow 异步 ────────────────────────────────────────────────────────────
WORKFLOW_ASYNC_ENABLED=true

# ── 日志轮转（仅 Linux 生效；Windows 忽略）────────────────────────────────
BACKUP_COMMON_LOG=true

# ── 其他 ─────────────────────────────────────────────────────────────────────
IR_LLM_API_KEY=sk-placeholder
PLUGIN_SSL_API_CERT=false
WORKFLOW_EXECUTE_TIMEOUT=900
KOOSEARCH_ENDPOINT=
FRONT_PAGE_BLOCK_NODES=Sql,DataQuery,Agent
SHARE_KNOWLEDGE_ENABLED=true
KNOWLEDGE_SOURCE=LakeSearch
KNOWLEDGE_LAKESEARCH_ENDPOINT=
KNOWLEDGE_LAKESEARCH_AUTH_MODE=basic
# API 文档统一开关：默认关闭，置 true 时同时开启管理面和运行面接口文档
# 管理面：http://127.0.0.1:31111/swagger-ui.html
# 运行面：http://127.0.0.1:31014/runtime/docs
API_DOCS_ENABLED=false
