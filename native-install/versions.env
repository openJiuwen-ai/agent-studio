###############################################################################
# native-install/versions.env  —  原生依赖下载源（单一真相源）
###############################################################################
# 构建脚本读此文件下载 Windows + Linux x64 原生依赖并内置到包内。
# 改版本/换源只动这里。SHA256 留空则跳过校验（仅警告）；填上则强校验。
#
# 说明：
#  - Python 用 python-build-standalone（indygreg），两平台都自带 pip，无 _pth 坑。
#  - Linux nginx 无官方预编译二进制可整包下载，故取源码包，构建机用 gcc 编译为
#    最小二进制（--without-http_rewrite_module --without-http_gzip_module，免 pcre/zlib）。
#  - Windows Redis 用社区移植版 redis-windows（官方无 Windows 版）。
#  - 任何 URL 失效：构建脚本 curl -fSL 会 fail-fast，换 URL 重跑即可。
###############################################################################

# ── 构建产物版本号（写入 MANIFEST，用于打包名）─────────────────────────────
BUNDLE_NAME=AgentStudio
BUNDLE_VERSION=1.0.0

# ── GitHub 加速镜像（可选）──────────────────────────────────────────────────
# 非空时，fetch_deps 会给 https://github.com/* 的下载 URL 前缀此值。
# 国内访问 github.com 极慢时启用。留空=直连。换镜像只改这里。
# 实测：ghfast.top ≈ 150KB/s（直连 ~36KB/s）；gh-proxy.com/ghps.cc 当前不可达。
GITHUB_MIRROR=https://ghfast.top/

# ── JRE 17 (Eclipse Temurin) ────────────────────────────────────────────────
JRE17_VERSION=17.0.13+11
JRE17_WIN_URL=https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.13%2B11/OpenJDK17U-jre_x64_windows_hotspot_17.0.13_11.zip
JRE17_WIN_SHA256=
JRE17_LINUX_URL=https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.13%2B11/OpenJDK17U-jre_x64_linux_hotspot_17.0.13_11.tar.gz
JRE17_LINUX_SHA256=

# ── MySQL 8.0 ───────────────────────────────────────────────────────────────
MYSQL_VERSION=8.0.40
MYSQL_WIN_URL=https://dev.mysql.com/get/Downloads/MySQL-8.0/mysql-8.0.40-winx64.zip
MYSQL_WIN_SHA256=
MYSQL_LINUX_URL=https://dev.mysql.com/get/Downloads/MySQL-8.0/mysql-8.0.40-linux-glibc2.17-x86_64-minimal.tar.xz
MYSQL_LINUX_SHA256=

# ── Redis 7 ──────────────────────────────────────────────────────────────────
# Linux：Remi el7 预编译 RPM（glibc 2.17，目标 RHEL 系开箱即用）——不再源码编译。
#   官方 download.redis.io 只发源码 tarball；Remi el7 包已是 glibc2.17 可移植二进制
#  （ldd 最高 GLIBC_2.17）。依赖 libssl.so.10/libcrypto.so.10/libsystemd 等均为 RHEL 系
#   标准包，EulerOS 等目标机自带；缺则用下方"Linux 兼容库"兜底。Remi el7 最高仅到 7.0.14
#   （el7 在 7.4 发布前 EOL），协议兼容应用无感。
REDIS_VERSION=7.4.2
REDIS_LINUX_URL=https://rpms.remirepo.net/enterprise/7/remi/x86_64/redis-7.0.14-1.el7.remi.x86_64.rpm
REDIS_LINUX_SHA256=
# Windows 社区移植版：redis-windows/redis-windows（tporadowski fork 最高仅 5.0.14.1，
#   无 7.x Windows 版；该项目只发 8.x）。Win 用 8.2.7 cygwin 构建（zip 含 cygwin DLL，
#   直接跑 redis-server.exe）。Linux 用 Remi el7 预编译 7.0.14——两平台版本不同但协议兼容。
#   目录标签沿用 deps/win/redis-7（启动脚本硬编码该名，仅标签勿据此改）。
REDIS_WIN_VERSION=8.2.7
REDIS_WIN_URL=https://github.com/redis-windows/redis-windows/releases/download/8.2.7/Redis-8.2.7-Windows-x64-cygwin.zip
REDIS_WIN_SHA256=

# ── Linux 兼容库（centos7 vault，glibc 2.17，给缺库的目标机兜底）────────────────
# MySQL 客户端需 libncurses.so.5/libtinfo.so.5，mysqld 需 libaio.so.1/libnuma.so.1；
# Remi redis 链 libssl.so.10/libcrypto.so.10（OpenSSL 1.0，EulerOS 2.0 只带 1.1/3.x 缺之）。
# 目标 RHEL 系通常自带 ncurses/aio/numa，缺则用这些 glibc2.17 库 bundle 进 deps/linux/lib/，
# start/stop 脚本设 LD_LIBRARY_PATH 指向它（同 ABI 不覆盖系统库，仅补缺）。
NCURSES_LIBS_URL=https://vault.centos.org/7.9.2009/os/x86_64/Packages/ncurses-libs-5.9-14.20130511.el7_4.x86_64.rpm
NCURSES_LIBS_SHA256=
LIBAIO_URL=https://vault.centos.org/7.9.2009/os/x86_64/Packages/libaio-0.3.109-13.el7.x86_64.rpm
LIBAIO_SHA256=
NUMACTL_LIBS_URL=https://vault.centos.org/7.9.2009/os/x86_64/Packages/numactl-libs-2.0.12-5.el7.x86_64.rpm
NUMACTL_LIBS_SHA256=
OPENSSL_LIBS_URL=https://vault.centos.org/7.9.2009/updates/x86_64/Packages/openssl-libs-1.0.2k-26.el7_9.x86_64.rpm
OPENSSL_LIBS_SHA256=

# ── MinIO server + mc（单文件二进制）──────────────────────────────────────
# 用国内镜像 dl.minio.org.cn（官方 dl.min.io 的 CDN 从国内连不稳，curl exit 56）。
# 不走 GITHUB_MIRROR（仅代理 github）；直连 .org.cn 实测 ~3MB/s。
MINIO_WIN_URL=https://dl.minio.org.cn/server/minio/release/windows-amd64/minio.exe
MINIO_WIN_SHA256=
MINIO_LINUX_URL=https://dl.minio.org.cn/server/minio/release/linux-amd64/minio
MINIO_LINUX_SHA256=
MC_WIN_URL=https://dl.minio.org.cn/client/mc/release/windows-amd64/mc.exe
MC_WIN_SHA256=
MC_LINUX_URL=https://dl.minio.org.cn/client/mc/release/linux-amd64/mc
MC_LINUX_SHA256=

# ── Python 3.11 (python-build-standalone，自带 pip) ──────────────────────────
# 仓库已迁至 astral-sh/python-build-standalone（indygreg 旧路径自动跳转，仍可用）。
PYTHON_VERSION=3.11.15
PYBUILD_TAG=20260718
PYTHON_WIN_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20260718/cpython-3.11.15+20260718-x86_64-pc-windows-msvc-install_only_stripped.tar.gz
PYTHON_WIN_SHA256=
PYTHON_LINUX_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20260718/cpython-3.11.15+20260718-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz
PYTHON_LINUX_SHA256=

# ── nginx ────────────────────────────────────────────────────────────────────
NGINX_VERSION=1.26.3
# Windows：官方 zip（含 nginx.exe + conf/mime.types）
NGINX_WIN_URL=https://nginx.org/download/nginx-1.26.3.zip
NGINX_WIN_SHA256=
# Linux：官方源码包（构建机 gcc 编译，带 gzip+rewrite 模块并静态捆绑 pcre2+zlib → 产物自包含）
NGINX_LINUX_URL=https://nginx.org/download/nginx-1.26.3.tar.gz
NGINX_LINUX_SHA256=
# nginx 编译依赖的 pcre2 / zlib 源码（--with-pcre/--with-zlib 静态编进 nginx，目标机无需 libpcre/libz）
PCRE2_URL=https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.43/pcre2-10.43.tar.gz
PCRE2_SHA256=
ZLIB_URL=https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz
ZLIB_SHA256=

# ── pip 离线 wheel 下载（供目标机离线安装 runtime 依赖）────────────────────
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com
