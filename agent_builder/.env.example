# agent_builder 本地开发配置
# 放在 agent_builder/ 目录下，启动时 CWD = agent_builder/。
# agent_builder 用 pydantic-settings 读配置，变量名与 agent-runtime 一致。本地密码/API Key 填明文。
#
# 用法（二选一）：
#   A) source 注入环境后启动（推荐，所有变量都生效）：
#        cd agent_builder && cp .env.example .env  # 填入真实值
#        set -a; source .env; set +a
#        ../agent-runtime/.venv/Scripts/python.exe -m agent_builder.EIBuilder
#   B) 不 source：Redis/DB/LLM/OBS 由 pydantic 直接读 .env；SERVER_*/HTTPS/LOG_LEVEL
#      需用 CLI 覆盖（--host/--port）或 export 环境变量：
#        ../agent-runtime/.venv/Scripts/python.exe -m agent_builder.EIBuilder --host 127.0.0.1 --port 31015
# 注：ServerSettings 无 env_file（与 agent-runtime 一致），故 SERVER_* 只从真实环境变量读。

# ============ Server（服务监听） ============
SERVER_HOST=127.0.0.1
SERVER_PORT=31015
# 本地用 HTTP；HTTPS=true 时需配证书（agent_builder/serve/settings.yaml 的 https 也建议改 false）
HTTPS=false
TLS_CERT_PATH=
TLS_CERT_KEY_PATH=
TLS_CERT_KEY_PASSWD=
LOG_LEVEL=INFO
# 本地调试建议单进程（默认 CPU+1 会 fan-out 多 worker）
GUNICORN_WORK_NUM=1

# ============ Redis（n2l history + lifespan ping；必填） ============
# 本地仅单机模式；集群/哨兵见 docker/compose/.env.example
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
# single / cluster / sentinel
REDIS_MODE=single
# 集群：REDIS_CLUSTER_NODES=host1:port1,host2:port2
# 哨兵：REDIS_SENTINEL_MASTER=mymaster + REDIS_SENTINEL_NODES=...

# ============ 数据库（prompt 优化任务持久化 ContextManager().set_store；选填） ============
# 不填则 prompt 优化仅存内存，服务重启丢失（lifespan 会 warn，不影响启动）
STORE_DB_TYPE=mysql          # 或 gaussdb
STORE_DB_HOST=
STORE_DB_PORT=3306
STORE_DB_USER=
STORE_DB_PASSWORD=
STORE_DB_DATABASE=
STORE_DB_SCHEMA=
STORE_DB_SSLMODE=disable

# ============ 对象存储（n2l/prompt 读写 IR/模板；按需） ============
# MinIO：https://<MINIO_IP>:9000 ；公有云 OBS：https://<OBS_ENDPOINT>:443
DATASOURCE_OBS_SERVER=
DATASOURCE_OBS_BUCKET=
DATASOURCE_OBS_AK=
DATASOURCE_OBS_SK=
DATASOURCE_OBS_ENABLE_SSL=false

# ============ LLM（n2l 对话调模型；模型也可由请求体 modelInfo 带入） ============
# 模型配置来源策略（与 agent_runtime 统一）：obs / ir / env
# - obs（默认）：进程内直连真实模型（client_provider=studio，由 packages/model_service
#   解析 OBS 模型服务元数据 + auth 后直连；需上游注入 X-Owner-Project-Id / X-Workspace-Id / X-Auth-Id
#   等头，由 server_fastapi 的请求上下文中间件透传到 _request_ctx）。
# - ir：走模型网关 MODEL_ROUTER_API（client_provider=openai，鉴权由网关处理）。
# - env：走 IR_LLM_* 环境变量（client_provider=openai，IR_LLM_API_BASE + IR_LLM_API_KEY）。
MODEL_CONFIG_STRATEGY=obs
# 仅 MODEL_CONFIG_STRATEGY=ir 且使用外部兼容模型网关时配置。
# 不要指向 studio-builder 自身，避免递归调用。
# MODEL_ROUTER_API=https://<model-gateway>/v1/agent-builder
IR_LLM_API_KEY=sk-placeholder
IR_LLM_MODEL_NAME=
IR_LLM_SSL_VERIFY=false
STREAM_READ_TIMEOUT=900

# ============ 健康检查自定义响应（选填） ============
CUSTOM_HEALTH_CHECK_RSP=

# ============ OpenTelemetry（选填，默认关闭；builder 默认不启用 trace） ============
OTEL_ENABLED=false
OTEL_SERVICE_NAME=agent-builder
