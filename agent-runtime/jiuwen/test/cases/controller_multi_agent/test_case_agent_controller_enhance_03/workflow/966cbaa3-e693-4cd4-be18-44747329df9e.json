        "code": "def main(args: dict) -> dict:\n    \"\"\"\n    运行代码节点会调用此函数\n    :param args: 输入固定为args字典类型，kv为输入参数键值对\n    :return: 输出参数为字典类型，kv为输出参数键值对\n    \"\"\"\n    intents: list = args.get('intents', [])\n    query: str = args.get('query', '')\n    \n    ret = {\n        \"intent_id\": 2\n    }\n    \n    # 如果query为空，直接返回\n    if not query:\n        return ret\n    \n    # 遍历intents列表，查找包含query的name\n    for intent in intents:\n        if isinstance(intent, dict) and 'name' in intent and 'id' in intent:\n            if query in intent['name']:\n                try:\n                    ret[\"intent_id\"] = int(intent['id'])\n                except (ValueError, TypeError):\n                    ret[\"intent_id\"] = 0\n                break\n    \n    return ret",
        "systemFields": {
          "inputs": [],
          "outputs": []
        }
