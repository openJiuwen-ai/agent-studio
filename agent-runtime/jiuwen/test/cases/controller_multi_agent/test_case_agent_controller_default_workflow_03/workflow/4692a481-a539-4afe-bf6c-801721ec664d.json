        "code": "def main(args: dict) -> dict:\n    import json\n    startDate = \"\"\n    endDate = \"\"\n    inOutFlag = \"\"\n    amount = \"\"\n    trxsite = \"\"\n    userName = \"\"\n    note = \"\"\n    numSize = 0\n    numSizeTemp = \"\"\n    modelFlag = \"1\"\n    try:\n        result = json.loads(args.get('raw_output'))\n        startDate = result.get(\"交易开始时间\")\n        endDate = result.get(\"交易结束时间\")\n        inOutFlag = result.get(\"业务摘要\")\n        amount = str(result.get(\"交易金额\")).split('.')[0]\n        if amount == \"None\":\n            amount = \"\"\n        numSizeTemp = str(result.get(\"笔数\")).split(' ')[0]\n        if numSizeTemp == \"None\":\n            numSize = 0\n        else:\n            numSize = int(numSizeTemp)\n        trxsite = result.get(\"交易场所\")\n        userName = result.get(\"对方户名\")\n        modelFlag = \"2\"\n    except:\n        startDate = \"\"\n        endDate = \"\"\n        inOutFlag = \"\"\n        amount = \"\"\n        trxsite = \"\"\n        userName = \"\"\n        note = \"\"\n        numSize = 0\n        modelFlag = \"1\"\n\n    if startDate == \"\" and endDate == \"\" and inOutFlag == \"\" and inOutFlag == \"\" and trxsite == \"\" and userName == \"\" and numSize ==0:\n        modelFlag = \"1\"\n\n    ret = {\n        \"startDate\": startDate,\n        \"endDate\": endDate,\n        \"inOutFlag\": inOutFlag,\n        \"amount\": amount,\n        \"trxsite\": trxsite,\n        \"userName\": userName,\n        \"note\": \"\",\n        \"numSize\": numSize,\n        \"modelFlag\": modelFlag\n    }\n\n    return ret",
