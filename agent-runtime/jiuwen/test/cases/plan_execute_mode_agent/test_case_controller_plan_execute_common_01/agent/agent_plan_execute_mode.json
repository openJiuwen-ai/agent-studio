{
  "schemaVersion": "0.6.0",
  "agentId": "pe_agent_test",
  "agentVersion": "0.6.0",
  "description": "PlanExecute 模式测试 Agent，用于测试动态规划执行流程",
  "agentName": "动态规划测试Agent",
  "configs": {
    "mode": "PlanExecute",
    "sysPromptTemplate": "你是一个专业的银行业务助手，擅长处理复杂的多步骤任务。请根据用户的请求，按照场景和指南逐步执行任务。",
    "global_variables": [
      {
        "default": "阿发",
        "description": "user_name",
        "name": "user_name",
        "type": "string"
      }
    ],
    "modelConfig": {
      "modelName": "mock_model_name",
      "modelType": "customer_chat_llm",
      "hyperParameters": {
        "temperature": 0.1,
        "top_p": 0.2
      },
      "extension": {}
    },
    "scenes": [
      {
        "id": "scene_credit_repay",
        "name": "信用卡还款",
        "description": "先查询账单，再查询用户账户余额，如果账户余额不足就先转账，最后再还款",
        "tools": [
          {
            "name": "parent_workflow_plugin_query_bill",
            "description": "查询信用卡账单"
          },
          {
            "name": "workflow_plugin_query_account",
            "description": "查询账户余额"
          },
          {
            "name": "workflow_plugin_transfer",
            "description": "账户间转账"
          },
          {
            "name": "parent_workflow_plugin_repay_credit",
            "description": "信用卡还款"
          }
        ],
        "guidelines": [
          {
            "id": 1,
            "condition": "假如用户要还信用卡",
            "action": "调用 parent_workflow_plugin_query_bill 工具查询账单金额",
            "tools": [
              "parent_workflow_plugin_query_bill"
            ]
          },
          {
            "id": 2,
            "condition": "假如用户要还信用卡，且已经查询到了信用卡账单",
            "action": "调用 workflow_plugin_query_account 工具查询用户账户余额",
            "tools": [
              "workflow_plugin_query_account"
            ]
          },
          {
            "id": 3,
            "condition": "假如账户余额不足",
            "action": "调用 workflow_plugin_transfer 工具转账",
            "tools": [
              "workflow_plugin_transfer"
            ]
          },
          {
            "id": 4,
            "condition": "假如账户余额充足",
            "action": "调用 parent_workflow_plugin_repay_credit 工具还款",
            "tools": [
              "parent_workflow_plugin_repay_credit"
            ]
          }
        ],
        "relations": [
          {
            "type": "dependency",
            "src": 1,
            "tgt": 2
          },
          {
            "type": "dependency",
            "src": 2,
            "tgt": 3
          },
          {
            "type": "dependency",
            "src": 2,
            "tgt": 4
          }
        ]
      }
    ],
    "plugins": [],
    "planning": {
      "max_steps": 10,
      "allow_replanning": false
    },
    "workflows": [
      {
        "name": "parent_workflow_plugin_query_bill",
        "id": "parent_workflow_plugin_query_bill",
        "ir_path": "parent_workflow_query_bill.json"
      },
      {
        "name": "workflow_plugin_query_account",
        "id": "workflow_plugin_query_account",
        "ir_path": "workflow_query_account.json"
      },
      {
        "name": "workflow_plugin_transfer",
        "id": "workflow_plugin_transfer",
        "ir_path": "workflow_transfer.json"
      },
      {
        "name": "parent_workflow_plugin_repay_credit",
        "id": "parent_workflow_plugin_repay_credit",
        "ir_path": "parent_workflow_repay_credit.json"
      }
    ],
    "maxIteration": 10
  }
}
