{
  "schemaVersion": "0.6.0",
  "agentId": "pe_skills_test",
  "agentVersion": "0.6.0",
  "description": "PlanExecute 模式测试 Agent，测试 workflow + skills 组合执行流程",
  "agentName": "KPI查询与异常分析Agent",
  "configs": {
    "mode": "PlanExecute",
    "sysPromptTemplate": "你是一个专业的数据分析助手。请根据用户的请求，按照场景和指南逐步执行任务。",
    "global_variables": [],
    "modelConfig": {
      "modelName": "mock_model_name",
      "modelType": "customer_chat_llm",
      "hyperParameters": {
        "temperature": 0.1,
        "top_p": 0.2
      },
      "extension": {}
    },
    "scenes": [
      {
        "id": "1",
        "name": "kpi查询和使用skill做异常分析",
        "description": "kpi查询和使用skill做异常分析",
        "tools": [
          {
            "name": "workflow_kpi",
            "description": "查询kpi数据"
          }
        ],
        "guidelines": [
          {
            "id": 1,
            "condition": "用户要查询kpi",
            "action": "调用workflow_kpi查询",
            "tools": [
              "workflow_kpi"
            ]
          },
          {
            "id": 2,
            "condition": "查询kpi后",
            "action": "异常分析这一步的具体内容请使用技能exception-analyzer分析error.log的异常，首先请调用read_file来读取SKILL.md文件，然后按照skill的每一个step往下走：先执行read_file，再执行execute_code，最后执行execute_shell",
            "tools": []
          }
        ],
        "relations": [
          {
            "type": "dependency",
            "src": 1,
            "tgt": 2
          }
        ]
      }
    ],
    "plugins": [],
    "planning": {
      "max_steps": 5,
      "allow_replanning": false
    },
    "workflows": [
      {
        "name": "workflow_kpi",
        "id": "workflow_kpi",
        "ir_path": "workflow_kpi.json"
      }
    ],
    "maxIteration": 10
  }
}