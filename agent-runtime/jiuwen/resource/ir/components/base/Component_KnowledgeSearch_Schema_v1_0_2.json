{
  "schemaVersion": "0.6",
  "type": "jiuwen.planner.components.plan_modules.knowledge_search:KnowledgeSearch",
  "version": "1.0.2",
  "description": "知识库检索组件",
  "classInfo": {
    "modulePath": "jiuwen.planner.components.plan_modules.knowledge_search",
    "className": "KnowledgeSearch",
    "programLanguage": "python",
    "filePath": "jiuwen/planner/components/planning_modules/knowledge_search.pyc"
  },
  "inputs": [
    {
      "id": "query",
      "type": "String",
      "description": "检索用的query文本",
      "constrains": {
        "required": true
      }
    }
  ],
  "outputs": [
    {
      "id": "knowledgeSegments",
      "type": "List<String>",
      "description": "知识片段，按照相关度从高到低排序"
    }
  ],
  "configs": [
    {
      "id": "knowledgeBases",
      "type": "List<String>",
      "description": "知识库的ID列表，最大10个"
    },
    {
      "id": "similarityThreshold",
      "type": "Float",
      "description": "相关性阈值：浮点值，取值范围由环境变量 knowledge_recall_threshold_min/max 配置，越靠近max代表越相关，召回结果可能就越精准、越少"
    },
    {
      "id": "maxResultCount",
      "type": "Int",
      "description": "最大召回片段数：正整数值，支持召回的最大片段数，取值范围[1-10]"
    },
    {
      "id": "maxTokenCount",
      "type": "Int",
      "description": "最大Token数：召回片段的文本部分的最大token数；取值范围[1-8000]"
    },
    {
      "id": "userFields",
      "type": "Map<String, T>",
      "description": "用户参数信息配置"
    },
    {
      "id": "preDefinedFields",
      "type": "Map<String, T>",
      "description": "预定义参数信息配置"
    },
    {
      "id": "debugType",
      "type": "Map<String, T>",
      "description": "调测树配置"
    }
  ]
}